NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000,https://abysocials.com,https://www.abysocials.com,https://yosocials.vercel.app

# Postgres connection string
DATABASE_URL=postgres://user:password@localhost:5432/abysocials
DATABASE_SSL=false
DATABASE_RUN_MIGRATIONS=true

# 32 random bytes, base64. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Losing or changing this key makes every stored account credential unreadable.
CREDENTIALS_ENCRYPTION_KEY=

# Signs access tokens. Generate the same way as CREDENTIALS_ENCRYPTION_KEY.
# Changing it signs everyone out.
JWT_SECRET=
AUTH_RATE_LIMIT_PER_MINUTE=10

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Tried in order; the agent moves on when a model is overloaded or slow.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODELS=gemini-3.8-flash
# Let the AI search the web (Grounding with Google Search). Needs a PAID Gemini key:
# Gemini 3 models get no grounding on the free tier. The paid tier includes 5,000 search
# queries a month, then about $14 per 1,000, capped by default at 1,500 search requests a
# day per project. Google's terms require showing the Search Suggestions and sources,
# unmodified, to the person who asked, and never caching them for anyone else.
GEMINI_SEARCH_GROUNDING=false

SCHEDULER_ENABLED=true

# TikTok (developers.tiktok.com). TikTok stays unavailable until all three are set.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=https://abysocials.com/integrations/tiktok/callback
# Each scope must be added to the TikTok app
TIKTOK_SCOPES=user.info.basic,user.info.profile,video.publish,video.upload,video.list

# Media uploads (UploadThing dashboard → API Keys). Same token as the web app's.
UPLOADTHING_TOKEN=
# The web app proxies /media/* to UploadThing, so TikTok pulls from a verified domain
MEDIA_PUBLIC_BASE_URL=https://abysocials.com/media

# X (console.x.com → your app → Keys and tokens, OAuth 2.0). X stays unavailable until all three are set.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://abysocials.com/integrations/x/callback
# Space-separated OAuth 2.0 scopes. offline.access gives a refresh token, so scheduled posts keep working.
X_SCOPES="tweet.read tweet.write users.read media.write offline.access"

# LinkedIn (linkedin.com/developers → your app). Add the products "Sign In with LinkedIn using OpenID Connect"
# and "Share on LinkedIn". LinkedIn stays unavailable until all three are set.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=https://abysocials.com/integrations/linkedin/callback
# Space-separated. Add r_member_postAnalytics once the Community Management API is approved.
LINKEDIN_SCOPES="openid profile w_member_social"
LINKEDIN_API_VERSION=202611
