API_URL=http://localhost:4000
# Canonical origin used for metadata, sitemap and robots (defaults to https://abysocials.com)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# UploadThing token (dashboard → API Keys): runs the upload route, and /media/* is proxied to its file host. Same value as the API's.
UPLOADTHING_TOKEN=
# The API holds the TikTok client key and secret; the web app only needs this route registered on the TikTok app:
# https://abysocials.com/integrations/tiktok/callback
